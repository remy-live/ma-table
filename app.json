{
  "expo": {
    "name": "Ma table",
    "slug": "ma-table-xr16",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "fr.remy.matable",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ma table a besoin du réseau local pour piloter ta table de mixage."
      }
    },
    "android": {
      "package": "fr.remy.matable",
      "permissions": [
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1014"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "scheme": "matable",
    "icon": "./assets/icon.png",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0E1014"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0E1014"
        }
      ]
    ]
  }
}