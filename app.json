{
  "expo": {
    "name": "Ma table",
    "slug": "ma-table-xr16",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "fr.remy.matable",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Ma table a besoin du réseau local pour piloter ta table de mixage.",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Réglages Ma table",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "fr.remy.matable.bundle"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "fr.remy.matable.bundle",
            "UTTypeDescription": "Réglages Ma table",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "matable"
              ],
              "public.mime-type": [
                "application/x-matable"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "fr.remy.matable",
      "permissions": [
        "INTERNET",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1014"
      },
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-matable"
            },
            {
              "scheme": "file",
              "pathPattern": ".*\\.matable"
            },
            {
              "scheme": "content",
              "pathPattern": ".*\\.matable"
            }
          ]
        }
      ]
    },
    "scheme": "matable",
    "icon": "./assets/icon.png",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0E1014"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0E1014"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L’appareil photo sert à scanner le QR code d’invitation du sondier.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withFontScale",
      "./plugins/withNoScriptSandbox"
    ]
  }
}
